{
  "expo": {
    "name": "Solar",
    "slug": "Solar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "solar",
    "jsEngine": "jsc",
    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "bundleIdentifier": "com.astromyllc.solar",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["solar"]
          }
        ]
      }
    },
    "android": {
      "package": "com.astromyllc.solar",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "solar",
              "host": "oauthredirect"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.INTERNET"]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "35a165b7-7f76-457d-9e82-1c1a48e259fb"
      }
    }
  }
}
