{
  "cli": {
    "version": ">= 7.8.2",
    "appVersionSource": "local" 
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "env": {
          "APP_AUTH_REDIRECT_SCHEME": "com.astromyllc.solar",
          "EXPO_NO_CACHE": "1"
        }
      }
    },
    "production": {
      "env": {
        "APP_AUTH_REDIRECT_SCHEME": "com.astromyllc.solar",
        "EXPO_NO_CACHE": "1"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:assembleRelease"
      }
    }
  }
}